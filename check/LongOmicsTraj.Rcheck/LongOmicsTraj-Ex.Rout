> cleanEx()
> nameEx("compute_vmm_deltas")
> ### * compute_vmm_deltas
> 
> flush(stderr()); flush(stdout())
> 
> base::assign(".ptime", proc.time(), pos = "CheckExEnv")
> ### Name: compute_vmm_deltas
> ### Title: Compute adjacent visit-to-visit deltas from a Visit Mean Matrix
> ### Aliases: compute_vmm_deltas
> 
> ### ** Examples
> 
> visits <- c(
+   "Baseline",
+   "Week 4",
+   "Week 12"
+ )
> 
> vmm <- data.frame(
+   object_id = rep(
+     c("gene_1", "gene_2"),
+     each = 3
+   ),
+   object_type = "gene",
+   group = "treated",
+   visit = rep(
+     visits,
+     times = 2
+   ),
+   estimated_value = c(
+     1.0, 1.6, 1.2,
+     2.0, 2.0, 2.5
+   ),
+   estimator = "empirical",
+   stringsAsFactors = FALSE
+ )
> 
> deltas <- compute_vmm_deltas(
+   vmm = vmm,
+   visits = visits
+ )
> 
> deltas[
+   ,
+   c(
+     "object_id",
+     "transition",
+     "delta_hat"
+   )
+ ]
  object_id         transition delta_hat
1    gene_1 Baseline_to_Week 4       0.6
2    gene_1  Week 4_to_Week 12      -0.4
3    gene_2 Baseline_to_Week 4       0.0
4    gene_2  Week 4_to_Week 12       0.5
> 
